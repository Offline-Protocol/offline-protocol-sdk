# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'OfflineDemo' do
  config = use_native_modules!

  # Manually add the local MeshSdk
  pod 'MeshSdk', :path => '../../../bindings/react-native/ios', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # fmt 11.0.2 (hard-pinned by RCT-Folly -> React Native 0.82) does not compile
    # under Xcode 26.5 / clang 21: clang defines __cpp_consteval, so fmt's base.h
    # selects FMT_USE_CONSTEVAL=1 and its consteval format-string check fails with
    # "call to consteval function ... is not a constant expression". base.h sets
    # FMT_USE_CONSTEVAL via a raw #if/#elif chain with NO #ifndef guard, so a
    # -DFMT_USE_CONSTEVAL=0 compile flag is silently overridden — the value must be
    # forced in the header. Rewrite the two `#define FMT_USE_CONSTEVAL 1` lines to
    # 0. Idempotent; re-applied on every `pod install`. Demo-app only — the SDK
    # sources are untouched.
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      original = File.read(fmt_base)
      patched = original.gsub('#  define FMT_USE_CONSTEVAL 1',
                              '#  define FMT_USE_CONSTEVAL 0')
      if patched != original
        File.write(fmt_base, patched)
        Pod::UI.puts 'Patched fmt/base.h: forced FMT_USE_CONSTEVAL=0 (Xcode 26.5 / clang 21)'.yellow
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        other_cflags = build_config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
        other_cxxflags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        warning_flag = '-Wno-error=return-type'
        unless other_cflags.include?(warning_flag)
          build_config.build_settings['OTHER_CFLAGS'] = "#{other_cflags} #{warning_flag}"
        end
        unless other_cxxflags.include?(warning_flag)
          build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{other_cxxflags} #{warning_flag}"
        end
        build_config.build_settings['SWIFT_STRICT_CONCURRENCY'] ||= 'minimal'
      end

      # Configure module map for MeshSdk pod
      if target.name == 'MeshSdk'
        target.build_configurations.each do |build_config|
          build_config.build_settings['DEFINES_MODULE'] = 'YES'
          build_config.build_settings['SWIFT_INCLUDE_PATHS'] = '$(PODS_TARGET_SRCROOT)/Generated'
        end
      end
    end
  end
end
