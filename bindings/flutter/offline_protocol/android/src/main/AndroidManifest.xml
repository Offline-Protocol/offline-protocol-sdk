<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 14 refuses a connectedDevice foreground service unless the app
         holds one of a fixed set of permissions, and start() always promotes
         one. This is an install-time permission in that set, so it holds before the
         app has asked for any Bluetooth permission; without it the refusal is
         followed by the system's own five-second kill. Wi-Fi Direct needs it
         too. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <application>
        <service
            android:name="com.offlineprotocol.MeshForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
