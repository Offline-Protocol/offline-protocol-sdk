{
  "name": "@offlineprotocol/react-native",
  "version": "0.1.0",
  "description": "Offline-first messaging SDK with intelligent transport switching for React Native",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "ios/",
    "android/",
    "src/",
    "scripts/",
    "react-native.config.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "build:ios": "bash scripts/build-ios.sh",
    "build:android": "bash scripts/build-android.sh",
    "build:all": "bash scripts/build-all.sh",
    "build:uniffi:ios": "bash scripts/build-uniffi-ios.sh",
    "build:uniffi:android": "bash scripts/build-uniffi-android.sh",
    "build:uniffi:all": "bash scripts/build-uniffi-all.sh",
    "generate:bindings": "bash scripts/generate-bindings.sh",
    "prepublishOnly": "npm run build && bash scripts/prepare-npm.sh",
    "clean": "rm -rf lib/"
  },
  "keywords": [
    "react-native",
    "offline",
    "messaging",
    "p2p",
    "mesh",
    "ble",
    "wifi-direct",
    "dors",
    "relay",
    "offline-first"
  ],
  "author": "Offline Protocol Team",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/offline-protocol/sdk.git",
    "directory": "bindings/react-native"
  },
  "homepage": "https://github.com/offline-protocol/sdk#readme",
  "bugs": {
    "url": "https://github.com/offline-protocol/sdk/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "react-native": "^0.82.0",
    "@types/react-native": "^0.72.0",
    "typescript": "^5.0.0"
  },
  "react-native": "src/index.ts"
}
