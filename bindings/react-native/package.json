{
  "name": "@offline-protocol/mesh-sdk",
  "version": "0.23.0",
  "description": "Offline-first mesh networking SDK with intelligent transport switching for React Native",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "ios/Generated/",
    "ios/libs/",
    "ios/ble/",
    "ios/mesh/",
    "ios/*.swift",
    "ios/*.m",
    "MeshSdk.podspec",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src/main/",
    "src/",
    "scripts/",
    "react-native.config.js",
    "README.md",
    "LICENSE",
    "LICENSE-COMMERCIAL.md",
    "THIRD-PARTY-NOTICES.md",
    "EXPORT.md"
  ],
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "test:js": "node js-ci-harness/one-shot-hold.test.js && node js-ci-harness/local-address.test.js && node js-ci-harness/relay-config.test.js && node js-ci-harness/data-config.test.js",
    "build:ios": "bash scripts/build-ios.sh",
    "build:android": "bash scripts/build-android.sh",
    "build:all": "bash scripts/build-all.sh",
    "build:uniffi:ios": "bash scripts/build-uniffi-ios.sh",
    "build:uniffi:android": "bash scripts/build-uniffi-android.sh",
    "build:uniffi:all": "bash scripts/build-uniffi-all.sh",
    "generate:bindings": "bash scripts/generate-bindings.sh",
    "prepublishOnly": "npm run clean && npm run build && bash scripts/prepare-npm.sh",
    "clean": "rm -rf lib/"
  },
  "keywords": [
    "react-native",
    "offline",
    "messaging",
    "p2p",
    "mesh",
    "ble",
    "wifi-direct",
    "dors",
    "relay",
    "offline-first"
  ],
  "author": "Offline Protocol, Inc.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Offline-Protocol/offline-protocol-sdk",
    "directory": "bindings/react-native"
  },
  "homepage": "https://github.com/Offline-Protocol/offline-protocol-sdk#readme",
  "bugs": {
    "url": "https://github.com/Offline-Protocol/offline-protocol-sdk/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@types/react-native": "^0.72.8",
    "react-native": "^0.87.0",
    "typescript": "^5.0.0"
  },
  "react-native": "src/index.ts"
}
