# Git Ignore
# For development - we may or may not commit binaries to git (can use git-lfs)

# Compiled TypeScript
lib/

# Node modules
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
*.tgz

# License files staged at publish time by scripts/prepare-npm.sh — the
# canonical copies live at the repo root.
LICENSE
LICENSE-COMMERCIAL.md

# Android
android/.gradle/
android/build/
android/.cxx/
android/local.properties

# iOS
ios/Pods/
ios/**/*.xcworkspace
ios/**/*.xcodeproj
!ios/**/*.xcodeproj/project.pbxproj
!ios/**/*.xcodeproj/xcshareddata
ios/Generated/
android/src/main/java/com/offlineprotocol/Generated/


package-lock.json

# Optional: If using git-lfs for binaries, don't ignore them
# If not using git-lfs and binaries are large, you can ignore them:
# ios/libs/*.a
# android/src/main/jniLibs/**/*.so
