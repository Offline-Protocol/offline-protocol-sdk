# Git Ignore
# For development - we may or may not commit binaries to git (can use git-lfs)

# Compiled TypeScript
lib/

# Node modules
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
*.tgz

# Android
android/.gradle/
android/build/
android/.cxx/
android/local.properties

# iOS
ios/Pods/
ios/**/*.xcworkspace
ios/**/*.xcodeproj
!ios/**/*.xcodeproj/project.pbxproj
!ios/**/*.xcodeproj/xcshareddata
ios/Generated/
android/src/main/java/com/offlineprotocol/Generated/


package-lock.json

# Build output. The root .gitignore already covers *.a, but the iOS XCFramework
# also carries an Info.plist, so the bundle needs ignoring as a whole — otherwise
# the artifact directory shows up as untracked after every native build.
ios/libs/

# Optional: If using git-lfs for binaries, don't ignore them
# If not using git-lfs and binaries are large, you can ignore them:
# ios/libs/*.a
# android/src/main/jniLibs/**/*.so
