<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Bluetooth permissions for BLE functionality -->
    
    <!-- Legacy Bluetooth permissions (Android 11 and below) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    
    <!-- Location permission required for BLE scanning on Android 11 and below
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    -->
    <!-- Android 12+ Bluetooth permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    
    <!-- Wi-Fi Direct, the peer-stream slot on Android. WifiP2pManager needs
         ACCESS_WIFI_STATE and CHANGE_WIFI_STATE (install-time) on every
         version, and NEARBY_WIFI_DEVICES (runtime) on Android 13+. The
         manager never derives location from Wi-Fi, so it asserts
         neverForLocation and needs no location grant on 13+. Android 12 and
         lower gate peer discovery on ACCESS_FINE_LOCATION, which the app
         declares and requests, as it does for BLE on 11 and lower. Without
         these the manager reported "WiFi P2P is not available on this device"
         on a phone that has it. The stream itself is a TCP socket. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The same slot's LAN carrier (LanPeerDiscovery): it watches for a
         Wi-Fi network and binds its dials to it, and before T extensions 7
         (Android 12 and lower) holds a multicast lock while browsing, which
         mDNS needs there. Both install-time, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- BLE feature requirement (not required to allow installation on devices without BLE) -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Foreground Service permissions for background mesh operation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Required by the mesh wake service: React Native's HeadlessJsTaskService
         takes a PARTIAL_WAKE_LOCK for the lifetime of a headless task, so the
         permission has to be held by whoever starts one. Normal permission, no
         runtime grant. Only ever exercised by an app that opted in to
         MESH_WAKE_ENABLED. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".MeshForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Boots JavaScript after a process kill so a receiver exists before a
             protocol does (issue #307). Inert unless the app opts in with
             <meta-data android:name="com.offlineprotocol.MESH_WAKE_ENABLED"
             android:value="true" /> and registers a task via
             registerMeshWakeTask. Not a foreground service and never promotes
             itself: it is started from under the already-promoted keep-alive.
             Not exported — only this SDK's own service starts it. -->
        <service
            android:name=".MeshHeadlessWakeService"
            android:enabled="true"
            android:exported="false" />
    </application>
    
</manifest>

