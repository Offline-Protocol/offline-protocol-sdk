# NPM Ignore
# This file specifies what NOT to include in the npm package
# IMPORTANT: Pre-built binaries MUST be included for plug-and-play installation

# Source files (only compiled lib/ is needed)
src/
tsconfig.json

# Build artifacts (don't ignore scripts - maintainers need them)
*.log
*.tgz

# Development files
.git
.github
.vscode
.idea

# Testing
__tests__/
__mocks__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage/

# Documentation (keep README.md)
docs/
*.md
!README.md

# Example apps
example/
ExampleApp/

# OS files
.DS_Store
Thumbs.db

# CRITICAL: Make sure pre-built binaries ARE included
# (by default they will be included, but explicitly state what to keep)
# We DO NOT ignore:
# - ios/libs/**/*.a
# - android/src/main/jniLibs/**/*.so
# - lib/ (compiled TypeScript)

