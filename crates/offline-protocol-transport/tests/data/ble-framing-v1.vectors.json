{
  "_comment": [
    "Conformance vectors for the Bluetooth LE fragment framing described in",
    "docs/spec/ble-framing.md. Frames are hex; `payload_utf8` is the reassembled",
    "hop-local encoding (here the JSON floor) that a conforming receiver must",
    "hand upward. Computed from the format definition in that chapter, not by",
    "running the implementation."
  ],
  "format": {
    "magic": "4f50",
    "version": 1,
    "header_fixed_bytes": 10,
    "byte_order": "little-endian for index, total and data_len",
    "header_layout": "magic(2) version(1) id_len(1) id(id_len) index(2) total(2) data_len(2) data(data_len)"
  },
  "sizing": {
    "_comment": "max_fragment_payload = mtu - header_fixed_bytes - id_len",
    "fragment_payload_floor_mtu": 185,
    "max_reasonable_payload": 512,
    "uuid_id_len": 36,
    "worked_example": {
      "mtu": 185,
      "id_len": 36,
      "max_fragment_payload": 139
    }
  },
