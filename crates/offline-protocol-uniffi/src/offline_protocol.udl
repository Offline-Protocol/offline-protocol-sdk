namespace offline_protocol {
};

// ========================================================================
// MLS (Message Layer Security) TYPES
// ========================================================================

// Error type for MLS storage operations
[Error]
enum MlsStorageError {
    "StoreFailed",
    "LoadFailed",
    "DeleteFailed",
    "KeyNotFound",
    "CorruptedData",
};

// MLS Storage callback interface - apps implement this for platform-native secure storage
callback interface MlsStorageProvider {
    // Store data with the given key type and ID
    [Throws=MlsStorageError]
    void store(string key_type, string key_id, sequence<u8> data);
    
    // Load data for the given key type and ID (returns null if not found)
    [Throws=MlsStorageError]
    sequence<u8>? load(string key_type, string key_id);
    
    // Delete data for the given key type and ID
    [Throws=MlsStorageError]
    void delete(string key_type, string key_id);
    
    // List all key IDs for a given key type
    [Throws=MlsStorageError]
    sequence<string> list_keys(string key_type);
};

// Key package bundle for distribution
dictionary MlsKeyPackageBundle {
    string package_id;
    string user_id;
    sequence<u8> key_package_data;
    u64 created_at_ms;
    u64 expires_at_ms;
    boolean synced;
};

// Welcome message for inviting users to a group
dictionary MlsWelcomeMessage {
    string group_id;
    sequence<u8> welcome_data;
    string inviter_id;
    string? group_name;
    u64 timestamp_ms;
};

// Encrypted message for transport
dictionary MlsEncryptedMessage {
    string group_id;
    string message_type;
    u64 epoch;
    sequence<u8> ciphertext;
    string sender_id;
    u64 timestamp_ms;
};

// Group information
dictionary MlsGroupInfo {
    string group_id;
    string? name;
    sequence<string> members;
    u64 epoch;
    boolean is_session;
    u64 created_at_ms;
    u64 last_activity_ms;
};

// Error types
[Error]
enum ProtocolError {
    "NotStarted",
    "AlreadyStarted",
    "InvalidConfiguration",
    "SendFailed",
    "InvalidState",
    "MlsNotInitialized",
    "MlsError",
    "Other",
};

// Message priority levels
enum MessagePriority {
    "Low",
    "Medium",
    "High",
    "Critical",
};

// Transport types
enum TransportType {
    "Internet",
    "Ble",
    "WiFiDirect",
};

// Protocol state
enum ProtocolState {
    "Stopped",
    "Starting",
    "Running",
    "Paused",
    "Stopping",
};

// Relay priority
enum RelayPriority {
    "Low",
    "Medium",
    "High",
};

// BLE peer device information
dictionary PeerDevice {
    string peer_id;
    i16 rssi;
    u64 last_seen_ms;
};

// BLE transport metrics
dictionary TransportMetrics {
    u32 packets_sent;
    u32 packets_received;
    u32 bytes_sent;
    u32 bytes_received;
    f32 error_rate;
    u32 avg_latency_ms;
};

// File transfer progress information
dictionary FileProgress {
    string file_id;
    u32 chunks_sent;
    u32 total_chunks;
    u8 percentage;
};

// Message delivery statistics
dictionary MessageStats {
    string message_id;
    u64 sent_at_ms;
    u64? delivered_at_ms;
    u8 hop_count;
    string status;
};

// Network topology node
dictionary NetworkNode {
    string node_id;
    string role;
    i16? rssi;
    u64 last_seen_ms;
};

// Network topology link
dictionary NetworkLink {
    string source_id;
    string target_id;
    string transport;
    f32 quality;
};

// Network topology
dictionary NetworkTopology {
    sequence<NetworkNode> nodes;
    sequence<NetworkLink> links;
    sequence<MessageStats> message_stats;
};

// DORS (Dynamic Offline Relay Switch) configuration
dictionary DorsConfig {
    boolean prefer_online;
    f32 switch_hysteresis;
    u64 switch_cooldown_secs;
    u32 ble_to_wifi_retry_threshold;
    i16 rssi_switch_threshold;
    u64 congestion_queue_threshold;
    u64 stability_window_secs;
    u64 poor_signal_duration_secs;
    u8 ttl_escalation_threshold;
    u64 congestion_duration_secs;
    u64 ttl_escalation_hold_secs;
    u64 history_window_size;
    f32 queue_recovery_ratio;
};

// ACK configuration
dictionary AckConfig {
    u64 default_timeout_ms;
    u64 max_pending_acks;
};

// Retry configuration
dictionary RetryConfig {
    u32 max_retries;
    u64 initial_delay_ms;
    u64 max_delay_ms;
    f32 backoff_multiplier;
    u64 outbox_max_lifetime_ms;
};

// Deduplication configuration
dictionary DedupConfig {
    u64 max_tracked_messages;
    u64 retention_time_secs;
};

// Deduplicator statistics for monitoring
dictionary DedupStats {
    u64 total_tracked;
    u64 recent_tracked;
    u8 capacity_used_percent;
    string mode;
};

// Reliability configuration
dictionary ReliabilityConfig {
    AckConfig ack;
    RetryConfig retry;
    DedupConfig dedup;
};

// Path selection configuration
dictionary PathConfig {
    u32 forward_to_top_k;
    u32 max_congestion_level;
};

// Gradient routing table entry - represents a learned route to a destination
dictionary RouteEntry {
    string next_hop;
    u8 hop_count;
    f32 quality;
    u64 last_seen_ms;
};

// Gradient routing configuration
dictionary GradientRoutingConfig {
    u32 max_routes_per_destination;
    u64 route_ttl_secs;
    u32 max_routing_table_size;
};

// Routing table statistics for monitoring
dictionary RoutingStats {
    u32 destination_count;
    u32 route_count;
};

// Relay configuration
dictionary RelayConfig {
    u64 relay_threshold;
    u8 min_battery_for_relay;
    boolean allow_relay;
    RelayPriority relay_priority;
};

// Transport configuration
dictionary TransportConfig {
    boolean ble_enabled;
    boolean wifi_direct_enabled;
    boolean internet_enabled;
};

// Encryption configuration for automatic MLS handling
dictionary EncryptionConfig {
    boolean enabled;
    boolean auto_key_exchange;
    boolean store_pending;
};

// Extended configuration for protocol creation
dictionary ProtocolConfig {
    string app_id;
    string user_id;
    boolean ble_enabled;
    boolean wifi_direct_enabled;
    boolean internet_enabled;
    boolean prefer_online;
    u8 initial_ttl;
    boolean encryption_enabled;
    boolean auto_key_exchange;
    boolean store_pending;
};

// Extended protocol configuration with all options
dictionary ProtocolConfigExtended {
    string app_id;
    string user_id;
    TransportConfig transport;
    DorsConfig dors;
    RelayConfig relay;
    PathConfig path;
    ReliabilityConfig reliability;
    u8 initial_ttl;
};

// Event callback interface
callback interface EventCallback {
    void on_event(string event_json);
};

// Main protocol interface
interface OfflineProtocol {
    // Create a new protocol instance
    [Throws=ProtocolError]
    constructor(ProtocolConfig config);
    
    // Lifecycle management
    [Throws=ProtocolError]
    void start();
    
    [Throws=ProtocolError]
    void stop();
    
    [Throws=ProtocolError]
    void pause();
    
    [Throws=ProtocolError]
    void resume();
    
    ProtocolState get_state();
    
    // Process the protocol (internal message processing)
    [Throws=ProtocolError]
    void process();
    
    // Event handling
    void set_event_callback(EventCallback callback);
    
    string? poll_event();
    
    void emit_test_event();
    
    // Messaging
    [Throws=ProtocolError]
    string send_message(string recipient, string content, MessagePriority priority, string? reply_to_msg);
    
    string? receive_message();
    
    // BLE transport operations
    [Throws=ProtocolError]
    void ble_peer_discovered(string peer_id, i16 rssi);
    
    [Throws=ProtocolError]
    void ble_peer_lost(string peer_id);
    
    [Throws=ProtocolError]
    void ble_status_changed(boolean is_available);
    
    [Throws=ProtocolError]
    void ble_fragment_received(string sender_id, sequence<u8> fragment);
    
    BleFragment? ble_get_next_fragment();
    
    void ble_return_fragment();
    
    u32 ble_get_peer_count();
    
    // Internet transport operations
    [Throws=ProtocolError]
    void internet_status_changed(boolean is_connected);
    
    [Throws=ProtocolError]
    void internet_message_received(string sender_id, sequence<u8> data);
    
    InternetMessage? internet_get_next_message();
    
    void internet_return_message();
    
    // WiFi Direct transport operations
    [Throws=ProtocolError]
    void wifi_direct_status_changed(boolean is_connected);
    
    [Throws=ProtocolError]
    void wifi_direct_message_received(string sender_id, sequence<u8> data);
    
    WifiDirectMessage? wifi_direct_get_next_message();
    
    [Throws=ProtocolError]
    void wifi_direct_peer_connected(string peer_id);
    
    [Throws=ProtocolError]
    void wifi_direct_peer_disconnected(string peer_id);
    
    // Transport management
    [Throws=ProtocolError]
    void add_internet_transport(string server_url, u16 port);
    
    [Throws=ProtocolError]
    void add_wifi_direct_transport();
    
    [Throws=ProtocolError]
    void remove_transport(TransportType transport_type);
    
    sequence<string> get_active_transports();
    
    [Throws=ProtocolError]
    void update_transport_metrics(TransportType transport_type, TransportMetrics metrics);
    
    // DORS decision support
    boolean should_escalate_to_wifi();
    
    // File transfer
    [Throws=ProtocolError]
    string send_file(string recipient, string file_path, string file_name);
    
    [Throws=ProtocolError]
    void process_file_chunk(string file_id, u32 chunk_index, sequence<u8> data);
    
    FileProgress? get_file_progress(string file_id);
    
    [Throws=ProtocolError]
    void finalize_file(string file_id);
    
    [Throws=ProtocolError]
    void cancel_file_transfer(string file_id);
    
    // Network visualization and metrics
    [Throws=ProtocolError]
    NetworkTopology get_topology();
    
    sequence<MessageStats> get_message_stats();
    
    f32 get_delivery_success_rate();
    
    u64 get_median_latency();
    
    u8 get_median_hops();
    
    // Battery and device management
    void set_battery_level(u8 level);
    
    u8? get_battery_level();
    
    // Relay management
    [Throws=ProtocolError]
    void set_relay_priority(RelayPriority priority);
    
    RelayPriority get_relay_priority();
    
    boolean is_relay();
    
    // Transport metrics (per-transport detailed stats)
    TransportMetrics? get_transport_metrics(TransportType transport_type);
    
    // Manual transport control
    [Throws=ProtocolError]
    void force_transport(TransportType transport_type);
    
    void release_transport_lock();
    
    // Configuration updates (runtime)
    [Throws=ProtocolError]
    void update_dors_config(DorsConfig config);
    
    DorsConfig get_dors_config();
    
    // Gradient routing table operations
    // Learn a route from an incoming message - call when receiving a message from a neighbor
    void learn_route(string destination, string next_hop, u8 hop_count, f32 quality);
    
    // Get the best (highest quality) route to a destination
    RouteEntry? get_best_route(string destination);
    
    // Get all valid (non-expired) routes to a destination
    sequence<RouteEntry> get_all_routes(string destination);
    
    // Check if a route exists to the destination
    boolean has_route(string destination);
    
    // Remove all routes through a neighbor (call on disconnect)
    void remove_neighbor_routes(string neighbor_id);
    
    // Clean up expired routes (call periodically)
    void cleanup_expired_routes();
    
    // Get routing table statistics
    RoutingStats get_routing_stats();
    
    // Update gradient routing configuration
    void update_routing_config(GradientRoutingConfig config);
    
    // Reliability configuration updates
    void update_ack_config(AckConfig config);
    void update_retry_config(RetryConfig config);
    void update_dedup_config(DedupConfig config);
    
    // Reliability statistics for monitoring
    DedupStats get_dedup_stats();
    u64 get_pending_ack_count();
    u64 get_retry_queue_size();
    
    // ========================================================================
    // MLS (END-TO-END ENCRYPTION) OPERATIONS
    // ========================================================================
    
    // Initialize MLS with a storage provider - MUST be called before using encryption
    [Throws=ProtocolError]
    void initialize_mls(MlsStorageProvider storage);
    
    // Check if MLS is initialized
    boolean is_mls_initialized();
    
    // Generate a key package for distribution to others
    [Throws=ProtocolError]
    MlsKeyPackageBundle mls_generate_key_package();
    
    // Get an existing key package or generate a new one
    [Throws=ProtocolError]
    MlsKeyPackageBundle mls_get_or_create_key_package();
    
    // Import a contact's key package (for initiating encrypted sessions)
    [Throws=ProtocolError]
    void mls_import_key_package(string user_id, sequence<u8> key_package_data);
    
    // Get pending key packages that need to be uploaded to server
    sequence<MlsKeyPackageBundle> mls_get_pending_key_packages();
    
    // Mark a key package as synced to server
    [Throws=ProtocolError]
    void mls_mark_key_package_synced(string package_id);
    
    // Check if a 1:1 session exists with another user
    boolean mls_has_session(string other_user_id);
    
    // Check if a pending key package is available for a peer
    boolean has_pending_key_package(string peer_id);
    
    // Establish a secure session with a peer (high-level API)
    // Returns the Welcome message if session was created, null if session already exists
    // Throws if no key package is available for the peer
    [Throws=ProtocolError]
    MlsWelcomeMessage? establish_secure_session(string peer_id);
    
    // Create a 1:1 session with another user (returns Welcome to send)
    [Throws=ProtocolError]
    MlsWelcomeMessage mls_create_session(string other_user_id);
    
    // Join a session using a Welcome message
    [Throws=ProtocolError]
    MlsGroupInfo mls_join_session(MlsWelcomeMessage welcome);
    
    // Encrypt a message for a 1:1 session
    [Throws=ProtocolError]
    MlsEncryptedMessage mls_encrypt_for_user(string other_user_id, sequence<u8> plaintext);
    
    // Decrypt a message from a 1:1 session
    [Throws=ProtocolError]
    sequence<u8>? mls_decrypt_from_user(MlsEncryptedMessage encrypted);
    
    // List all active 1:1 sessions
    sequence<string> mls_list_sessions();
    
    // Delete a 1:1 session
    [Throws=ProtocolError]
    void mls_delete_session(string other_user_id);
    
    // Get a pending Welcome message that needs to be sent
    MlsWelcomeMessage? mls_get_pending_welcome(string other_user_id);
    
    // Clear a pending Welcome message after sending
    [Throws=ProtocolError]
    void mls_clear_pending_welcome(string other_user_id);
    
    // Create a new group
    [Throws=ProtocolError]
    MlsGroupInfo mls_create_group(string group_name);
    
    // Add a member to a group (returns Welcome to send to new member)
    [Throws=ProtocolError]
    MlsWelcomeMessage mls_add_group_member(string group_id, sequence<u8> member_key_package);
    
    // Remove a member from a group
    [Throws=ProtocolError]
    MlsEncryptedMessage mls_remove_group_member(string group_id, string member_id);
    
    // Leave a group
    [Throws=ProtocolError]
    void mls_leave_group(string group_id);
    
    // Encrypt a message for a group
    [Throws=ProtocolError]
    MlsEncryptedMessage mls_encrypt_for_group(string group_id, sequence<u8> plaintext);
    
    // Decrypt a message from a group
    [Throws=ProtocolError]
    sequence<u8>? mls_decrypt_from_group(MlsEncryptedMessage encrypted);
    
    // Join a group using a Welcome message
    [Throws=ProtocolError]
    MlsGroupInfo mls_join_group(MlsWelcomeMessage welcome);
    
    // List all groups (excluding 1:1 sessions)
    sequence<string> mls_list_groups();
    
    // Get information about a group
    MlsGroupInfo? mls_get_group_info(string group_id);
    
    // Decrypt any encrypted message (auto-detects session vs group)
    [Throws=ProtocolError]
    sequence<u8>? mls_decrypt(MlsEncryptedMessage encrypted);
    
    // Process a Welcome message (auto-detects session vs group)
    [Throws=ProtocolError]
    MlsGroupInfo mls_process_welcome(MlsWelcomeMessage welcome);
    
    // ========================================================================
    // IDENTITY AND SIGNING OPERATIONS
    // ========================================================================
    
    // Get the identity public key (Ed25519, 32 bytes).
    // This is the public key used for MLS operations and can be shared with others.
    [Throws=ProtocolError]
    sequence<u8> get_identity_public_key();
    
    // Derive a deterministic user ID from a public key.
    // Returns a base58-encoded string derived from SHA-256(publicKey)[0:20].
    // The same public key always produces the same user ID.
    string derive_user_id_from_public_key(sequence<u8> public_key);
    
    // Sign arbitrary data with the identity private key (Ed25519).
    // Returns the signature as raw bytes (64 bytes).
    [Throws=ProtocolError]
    sequence<u8> sign_data(sequence<u8> data);
    
    // Verify a signature against a public key.
    // Returns true if the signature is valid, false otherwise.
    [Throws=ProtocolError]
    boolean verify_signature(sequence<u8> public_key, sequence<u8> data, sequence<u8> signature);
    
    // ========================================================================
    // PRESENCE AND KEY MANAGEMENT (RELAY SERVER API)
    // ========================================================================
    
    // Check if a user is online.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string check_presence(string username);
    
    // Request prekey bundle for a user to establish encrypted communication.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string request_prekey_bundle(string username);
    
    // Upload identity key and prekeys for Signal Protocol.
    // Returns JSON string to send via WebSocket relay.
    // Parameters are JSON strings that will be parsed and included in the payload.
    [Throws=ProtocolError]
    string upload_keys(string identity_key, string signed_prekey_json, string one_time_prekeys_json);
    
    // Set typing indicator in a conversation.
    // For direct messages, conversation_id should be the recipient's username.
    // For group chats, conversation_id should be the group_id.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string set_typing(string conversation_id);
    
    // Clear typing indicator in a conversation.
    // For direct messages, conversation_id should be the recipient's username.
    // For group chats, conversation_id should be the group_id.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string clear_typing(string conversation_id);
    
    // ========================================================================
    // GROUP MANAGEMENT (RELAY SERVER API)
    // ========================================================================
    
    // Create a new group. Creator becomes admin.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_create(string name);
    
    // Send encrypted message to a group. Content must be pre-encrypted by client.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_send_message(string group_id, string content, string? reply_to_msg);
    
    // Add member to group. Admin only.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_add_member(string group_id, string username);
    
    // Remove member from group. Admin only, or user can remove themselves.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_remove_member(string group_id, string username);
    
    // Set member as admin. Admin only.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_set_admin(string group_id, string username);
    
    // Remove admin role from member. Admin only.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_remove_admin(string group_id, string username);
    
    // Leave a group.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_leave(string group_id);
    
    // Delete a group. Admin only.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_delete(string group_id);
    
    // Get group information.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_get_info(string group_id);
    
    // Get all groups the user is a member of.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string group_get_user_groups();
};

// BLE fragment for outgoing data
dictionary BleFragment {
    string recipient_id;
    sequence<u8> data;
};

// Internet message for outgoing data
dictionary InternetMessage {
    string recipient_id;
    sequence<u8> data;
    string? reply_to_msg;
};

// WiFi Direct message for outgoing data
dictionary WifiDirectMessage {
    string recipient_id;
    sequence<u8> data;
};

