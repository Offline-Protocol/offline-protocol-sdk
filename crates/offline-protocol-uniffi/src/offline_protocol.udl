namespace offline_protocol {
};

// Error types
[Error]
enum ProtocolError {
    "NotStarted",
    "AlreadyStarted",
    "InvalidConfiguration",
    "SendFailed",
    "InvalidState",
    "Other",
};

// Message priority levels
enum MessagePriority {
    "Low",
    "Medium",
    "High",
    "Critical",
};

// Transport types
enum TransportType {
    "Internet",
    "Ble",
    "WiFiDirect",
};

// Protocol state
enum ProtocolState {
    "Stopped",
    "Starting",
    "Running",
    "Paused",
    "Stopping",
};

// Relay priority
enum RelayPriority {
    "Low",
    "Medium",
    "High",
};

// BLE peer device information
dictionary PeerDevice {
    string peer_id;
    i16 rssi;
    u64 last_seen_ms;
};

// BLE transport metrics
dictionary TransportMetrics {
    u32 packets_sent;
    u32 packets_received;
    u32 bytes_sent;
    u32 bytes_received;
    f32 error_rate;
    u32 avg_latency_ms;
};

// File transfer progress information
dictionary FileProgress {
    string file_id;
    u32 chunks_sent;
    u32 total_chunks;
    u8 percentage;
};

// Message delivery statistics
dictionary MessageStats {
    string message_id;
    u64 sent_at_ms;
    u64? delivered_at_ms;
    u8 hop_count;
    string status;
};

// Network topology node
dictionary NetworkNode {
    string node_id;
    string role;
    i16? rssi;
    u64 last_seen_ms;
};

// Network topology link
dictionary NetworkLink {
    string source_id;
    string target_id;
    string transport;
    f32 quality;
};

// Network topology
dictionary NetworkTopology {
    sequence<NetworkNode> nodes;
    sequence<NetworkLink> links;
    sequence<MessageStats> message_stats;
};

// DORS (Dynamic Offline Relay Switch) configuration
dictionary DorsConfig {
    boolean prefer_online;
    f32 switch_hysteresis;
    u64 switch_cooldown_secs;
    u32 ble_to_wifi_retry_threshold;
    i16 rssi_switch_threshold;
    u64 congestion_queue_threshold;
    u64 stability_window_secs;
    u64 poor_signal_duration_secs;
    u8 ttl_escalation_threshold;
    u64 congestion_duration_secs;
    u64 ttl_escalation_hold_secs;
    u64 history_window_size;
    f32 queue_recovery_ratio;
};

// ACK configuration
dictionary AckConfig {
    u64 default_timeout_ms;
    u64 max_pending_acks;
};

// Retry configuration
dictionary RetryConfig {
    u32 max_retries;
    u64 initial_delay_ms;
    u64 max_delay_ms;
    f32 backoff_multiplier;
    u64 outbox_max_lifetime_ms;
};

// Deduplication configuration
dictionary DedupConfig {
    u64 max_tracked_messages;
    u64 retention_time_secs;
};

// Reliability configuration
dictionary ReliabilityConfig {
    AckConfig ack;
    RetryConfig retry;
    DedupConfig dedup;
};

// Path selection configuration
dictionary PathConfig {
    u32 forward_to_top_k;
    u32 max_congestion_level;
};

// Gradient routing table entry - represents a learned route to a destination
dictionary RouteEntry {
    string next_hop;
    u8 hop_count;
    f32 quality;
    u64 last_seen_ms;
};

// Gradient routing configuration
dictionary GradientRoutingConfig {
    u32 max_routes_per_destination;
    u64 route_ttl_secs;
    u32 max_routing_table_size;
};

// Routing table statistics for monitoring
dictionary RoutingStats {
    u32 destination_count;
    u32 route_count;
};

// Relay configuration
dictionary RelayConfig {
    u64 relay_threshold;
    u8 min_battery_for_relay;
    boolean allow_relay;
    RelayPriority relay_priority;
};

// Transport configuration
dictionary TransportConfig {
    boolean ble_enabled;
    boolean wifi_direct_enabled;
    boolean internet_enabled;
};

// Extended configuration for protocol creation
dictionary ProtocolConfig {
    string app_id;
    string user_id;
    boolean ble_enabled;
    boolean wifi_direct_enabled;
    boolean internet_enabled;
    boolean prefer_online;
    u8 initial_ttl;
};

// Extended protocol configuration with all options
dictionary ProtocolConfigExtended {
    string app_id;
    string user_id;
    TransportConfig transport;
    DorsConfig dors;
    RelayConfig relay;
    PathConfig path;
    ReliabilityConfig reliability;
    u8 initial_ttl;
};

// Event callback interface
callback interface EventCallback {
    void on_event(string event_json);
};

// Main protocol interface
interface OfflineProtocol {
    // Create a new protocol instance
    [Throws=ProtocolError]
    constructor(ProtocolConfig config);
    
    // Lifecycle management
    [Throws=ProtocolError]
    void start();
    
    [Throws=ProtocolError]
    void stop();
    
    [Throws=ProtocolError]
    void pause();
    
    [Throws=ProtocolError]
    void resume();
    
    ProtocolState get_state();
    
    // Process the protocol (internal message processing)
    [Throws=ProtocolError]
    void process();
    
    // Event handling
    void set_event_callback(EventCallback callback);
    
    string? poll_event();
    
    void emit_test_event();
    
    // Messaging
    [Throws=ProtocolError]
    string send_message(string recipient, string content, MessagePriority priority);
    
    string? receive_message();
    
    // BLE transport operations
    [Throws=ProtocolError]
    void ble_peer_discovered(string peer_id, i16 rssi);
    
    [Throws=ProtocolError]
    void ble_peer_lost(string peer_id);
    
    [Throws=ProtocolError]
    void ble_status_changed(boolean is_available);
    
    [Throws=ProtocolError]
    void ble_fragment_received(string sender_id, sequence<u8> fragment);
    
    BleFragment? ble_get_next_fragment();
    
    void ble_return_fragment();
    
    u32 ble_get_peer_count();
    
    // Internet transport operations
    [Throws=ProtocolError]
    void internet_status_changed(boolean is_connected);
    
    [Throws=ProtocolError]
    void internet_message_received(string sender_id, sequence<u8> data);
    
    InternetMessage? internet_get_next_message();
    
    void internet_return_message();
    
    // WiFi Direct transport operations
    [Throws=ProtocolError]
    void wifi_direct_status_changed(boolean is_connected);
    
    [Throws=ProtocolError]
    void wifi_direct_message_received(string sender_id, sequence<u8> data);
    
    WifiDirectMessage? wifi_direct_get_next_message();
    
    [Throws=ProtocolError]
    void wifi_direct_peer_connected(string peer_id);
    
    [Throws=ProtocolError]
    void wifi_direct_peer_disconnected(string peer_id);
    
    // Transport management
    [Throws=ProtocolError]
    void add_internet_transport(string server_url, u16 port);
    
    [Throws=ProtocolError]
    void add_wifi_direct_transport();
    
    [Throws=ProtocolError]
    void remove_transport(TransportType transport_type);
    
    sequence<string> get_active_transports();
    
    [Throws=ProtocolError]
    void update_transport_metrics(TransportType transport_type, TransportMetrics metrics);
    
    // DORS decision support
    boolean should_escalate_to_wifi();
    
    // File transfer
    [Throws=ProtocolError]
    string send_file(string recipient, string file_path, string file_name);
    
    [Throws=ProtocolError]
    void process_file_chunk(string file_id, u32 chunk_index, sequence<u8> data);
    
    FileProgress? get_file_progress(string file_id);
    
    [Throws=ProtocolError]
    void finalize_file(string file_id);
    
    [Throws=ProtocolError]
    void cancel_file_transfer(string file_id);
    
    // Network visualization and metrics
    [Throws=ProtocolError]
    NetworkTopology get_topology();
    
    sequence<MessageStats> get_message_stats();
    
    f32 get_delivery_success_rate();
    
    u64 get_median_latency();
    
    u8 get_median_hops();
    
    // Battery and device management
    void set_battery_level(u8 level);
    
    u8? get_battery_level();
    
    // Relay management
    [Throws=ProtocolError]
    void set_relay_priority(RelayPriority priority);
    
    RelayPriority get_relay_priority();
    
    boolean is_relay();
    
    // Transport metrics (per-transport detailed stats)
    TransportMetrics? get_transport_metrics(TransportType transport_type);
    
    // Manual transport control
    [Throws=ProtocolError]
    void force_transport(TransportType transport_type);
    
    void release_transport_lock();
    
    // Configuration updates (runtime)
    [Throws=ProtocolError]
    void update_dors_config(DorsConfig config);
    
    DorsConfig get_dors_config();
    
    // Gradient routing table operations
    // Learn a route from an incoming message - call when receiving a message from a neighbor
    void learn_route(string destination, string next_hop, u8 hop_count, f32 quality);
    
    // Get the best (highest quality) route to a destination
    RouteEntry? get_best_route(string destination);
    
    // Get all valid (non-expired) routes to a destination
    sequence<RouteEntry> get_all_routes(string destination);
    
    // Check if a route exists to the destination
    boolean has_route(string destination);
    
    // Remove all routes through a neighbor (call on disconnect)
    void remove_neighbor_routes(string neighbor_id);
    
    // Clean up expired routes (call periodically)
    void cleanup_expired_routes();
    
    // Get routing table statistics
    RoutingStats get_routing_stats();
    
    // Update gradient routing configuration
    void update_routing_config(GradientRoutingConfig config);
};

// BLE fragment for outgoing data
dictionary BleFragment {
    string recipient_id;
    sequence<u8> data;
};

// Internet message for outgoing data
dictionary InternetMessage {
    string recipient_id;
    sequence<u8> data;
};

// WiFi Direct message for outgoing data
dictionary WifiDirectMessage {
    string recipient_id;
    sequence<u8> data;
};

