namespace offline_protocol {
};

// ========================================================================
// MLS (Message Layer Security) TYPES
// ========================================================================

// Error type for MLS storage operations
[Error]
enum MlsStorageError {
    "StoreFailed",
    "LoadFailed",
    "DeleteFailed",
    "KeyNotFound",
    "CorruptedData",
};

// MLS Storage callback interface - apps implement this for platform-native secure storage
callback interface MlsStorageProvider {
    // Store data with the given key type and ID
    [Throws=MlsStorageError]
    void store(string key_type, string key_id, sequence<u8> data);
    
    // Load data for the given key type and ID (returns null if not found)
    [Throws=MlsStorageError]
    sequence<u8>? load(string key_type, string key_id);
    
    // Delete data for the given key type and ID
    [Throws=MlsStorageError]
    void delete(string key_type, string key_id);
    
    // List all key IDs for a given key type
    [Throws=MlsStorageError]
    sequence<string> list_keys(string key_type);
};

// Install-scoped storage for non-cryptographic protocol/message state.
// Implementations must be removed with the app container.
//
// Values arrive already sealed for the sensitive categories and must be stored
// and returned verbatim — never inspected, re-encoded, or truncated.
//
// `load` must bound its read: check the entry's stored size first and never
// materialize (or copy across this boundary) more than 8 MiB. Core refuses to
// write anything near that, so a larger entry is corrupt or tampered. Core can
// only check a length it has already been handed, so an unbounded provider read
// defeats the size policy entirely.
//
// Drop such an entry and throw CorruptedData — not a null. Destruction and
// absence are different answers: a record the provider destroyed is settled
// with a terminal message_failed, because the application is holding the
// message id sendMessage returned for it, while absence is simply nothing to
// restore. Reserve CorruptedData for permanent losses; a transient read failure
// is LoadFailed, which leaves the record in place for a later launch.
//
// Values are `bytes`, not the `sequence<u8>` MlsStorageProvider uses above.
// That interface carries key material a few hundred bytes at a time, where the
// difference does not matter; these records reach megabytes. `sequence<u8>`
// generates List<UByte> on Kotlin, which boxes every element with no valueOf
// cache — on the order of two million short-lived objects per call for a 2 MiB
// record, on the way in and again on the way out — and [UInt8] rather than Data
// on Swift. `bytes` maps to ByteArray / Data / bytes with no per-element cost.
callback interface ProtocolStateStorageProvider {
    [Throws=MlsStorageError]
    void store(string key_type, string key_id, bytes data);

    [Throws=MlsStorageError]
    bytes? load(string key_type, string key_id);

    [Throws=MlsStorageError]
    void delete(string key_type, string key_id);

    [Throws=MlsStorageError]
    sequence<string> list_keys(string key_type);
};

// Key package bundle for distribution
dictionary MlsKeyPackageBundle {
    string package_id;
    string user_id;
    sequence<u8> key_package_data;
    u64 created_at_ms;
    u64 expires_at_ms;
    boolean synced;
};

// Welcome message for inviting users to a group
dictionary MlsWelcomeMessage {
    string group_id;
    sequence<u8> welcome_data;
    string inviter_id;
    string? group_name;
    u64 timestamp_ms;
};

// Encrypted message for transport
dictionary MlsEncryptedMessage {
    string group_id;
    string message_type;
    u64 epoch;
    sequence<u8> ciphertext;
    string sender_id;
    u64 timestamp_ms;
};

// Result of adding a member to an MLS group
dictionary MlsAddMemberResult {
    MlsWelcomeMessage welcome;
    MlsEncryptedMessage commit;
};

// Group information
dictionary MlsGroupInfo {
    string group_id;
    string? name;
    sequence<string> members;
    u64 epoch;
    boolean is_session;
    u64 created_at_ms;
    u64 last_activity_ms;
};

// Whether a rich group send right now would seal its extras, and which
// members are in the way (advisory pre-check; the send path re-evaluates)
dictionary GroupRichReadiness {
    boolean ready;
    sequence<string> unknown_members;
};

// Relay-side registration state of a group (group_relay_sync_state).
// Transitions surface as the group_relay_sync_changed event.
enum RelaySyncState {
    "Synced",
    "Pending",
    "Unsynced",
};

// Establishment state for a peer (for SessionNotReady and get_establishment_state)
enum EstablishmentState {
    "NoKeyPackage",
    "HaveKeyPackage",
    "SessionPending",
    "SessionConfirmed",
};

// Error types.
// New variants are appended only: generated bindings decode this enum by
// positional discriminant, so inserting or removing a variant breaks every
// committed Swift/Kotlin/Python binding.
[Error]
enum ProtocolError {
    "NotStarted",
    "AlreadyStarted",
    "InvalidConfiguration",
    "SendFailed",
    "NoKeyPackage",
    "SessionNotReady",
    "EncryptFailed",
    "InvalidState",
    "MlsNotInitialized",
    "MlsError",
    "UserBlocked",
    "MediaTransferLimit",
    "LockPoisoned",
    "Other",
    "TransportError",
    "SerializationError",
    "ServiceError",
    "GroupNotFound",
    "PermissionDenied",
    "InvalidArgument",
};

// Message priority levels
enum MessagePriority {
    "Low",
    "Medium",
    "High",
    "Critical",
};

// Presence status
enum PresenceStatus {
    "Online",
    "Away",
    "Offline",
};

// Transport types
enum TransportType {
    "Internet",
    "Ble",
    "WiFiDirect",
    "Reticulum",
    "Nostr",
};

// Protocol state
enum ProtocolState {
    "Stopped",
    "Running",
    "Paused",
};

// Relay priority
enum RelayPriority {
    "Low",
    "Medium",
    "High",
};

// BLE peer device information
dictionary PeerDevice {
    string peer_id;
    i16 rssi;
    u64 last_seen_ms;
};

// Per-transport metrics. The first six fields are the legacy shape preserved
// for source-compatibility with existing iOS/Android/RN consumers of
// `getTransportMetrics`; the remaining fields (all optional) mirror the
// richer Rust `TransportMetrics` struct and populate whenever a transport
// reports them. Same dictionary flows through both the pull path
// (`get_transport_metrics`) and the push path (`MetricsFrame.transports`).
dictionary TransportMetrics {
    u32 packets_sent;
    u32 packets_received;
    u32 bytes_sent;
    u32 bytes_received;
    f32 error_rate;
    u32 avg_latency_ms;
    // Extended fields — all optional so existing constructors still compile.
    i16? rssi;
    u64? bandwidth_bps;
    f32? congestion;
    u32? queue_depth;
    u8? battery_level;
    boolean? is_charging;
    u8? relay_connection_count;
    boolean? is_active_relay;
    f32? delivery_ratio;
    f32? drop_rate;
    f32? average_hop_count;
    f32? energy_cost;
};

// Content type for messages
enum ContentType {
    "Text",
    "Image",
    "Video",
    "Audio",
    "VoiceNote",
    "VideoNote",
    "File",
    "FileChunk",
    "Poll",
};

// Media metadata for attachments.
// The defaulted fields keep hand-written constructors source-compatible:
// uniffi renders them as defaulted constructor parameters.
dictionary MediaMetadata {
    string mime_type;
    string file_name;
    u64 file_size;
    u64? duration_ms;
    u32? width;
    u32? height;
    string? thumbnail_base64;
    string? media_id = null;
    string? download_url = null;
    string? thumbnail_url = null;
    string? encryption_key = null;
    string? iv = null;
    string? ciphertext_hash = null;
    string? sticker_provider = null;
    string? sticker_remote_id = null;
    string? sticker_kind = null;
};

// Quoted-reply context: an unverified display-level hint copied by the
// sending client (see core ReplyContext). Consumed by the rich send surface.
dictionary ReplyContext {
    string sender;
    string text;
    i64? timestamp = null;
    string? reply_media_label = null;
    string? reply_content_type = null;
};

// Forwarding attribution: an unverified display-level hint (see core
// ForwardInfo). Consumed by the rich send surface.
dictionary ForwardInfo {
    string original_sender;
    string original_message_id;
    i64 original_timestamp;
    u32 forward_count;
};

// Options for send_message_rich. The rich fields (reply_context,
// media_metadata, forward_info) only ever travel inside the MLS-sealed
// __RICH_V1__ body, and only toward recipients whose key package advertised
// rich_versions support; toward anyone else they are silently dropped —
// never sent cleartext. All fields defaulted so callers can pass only what
// they need. content_type must not be FileChunk (internal transport type),
// and rich extras over 32 KiB serialized are rejected — both InvalidArgument.
dictionary SendMessageOptions {
    MessagePriority? priority = null;
    string? reply_to_msg = null;
    ContentType? content_type = null;
    ReplyContext? reply_context = null;
    MediaMetadata? media_metadata = null;
    ForwardInfo? forward_info = null;
};

// Options for send_media_rich. The rich fields (caption, reply_to_msg,
// reply_context, forward_info) only ever travel inside the MLS-sealed
// chunk-0 plaintext, and only toward recipients whose key package advertised
// rich_versions support; toward anyone else — including every plaintext
// (encryption opt-out) transfer — they are silently dropped, never sent
// cleartext. All fields defaulted so callers can pass only what they need.
// An unparsable reply_to_msg, rich extras over 32 KiB serialized, or a
// file_id that is empty, over 4096 bytes, or already carried by an active
// outbound transfer are rejected — all InvalidArgument.
dictionary MediaSendOptions {
    MediaMetadata? media_metadata = null;
    string? caption = null;
    string? reply_to_msg = null;
    ReplyContext? reply_context = null;
    ForwardInfo? forward_info = null;
    string? file_id = null;
};

// File transfer progress information
dictionary FileProgress {
    string file_id;
    u32 chunks_sent;
    u32 total_chunks;
    u8 percentage;
};

// Message delivery statistics
dictionary MessageStats {
    string message_id;
    u64 sent_at_ms;
    u64? delivered_at_ms;
    u8 hop_count;
    string status;
};

// Network topology node
dictionary NetworkNode {
    string node_id;
    string role;
    i16? rssi;
    u64 last_seen_ms;
};

// Network topology link
dictionary NetworkLink {
    string source_id;
    string target_id;
    string transport;
    f32 quality;
};

// Network topology
dictionary NetworkTopology {
    sequence<NetworkNode> nodes;
    sequence<NetworkLink> links;
    sequence<MessageStats> message_stats;
};

// DORS (Dynamic Offline Relay Switch) configuration
dictionary DorsConfig {
    boolean prefer_online;
    f32 switch_hysteresis;
    u64 switch_cooldown_secs;
    u32 ble_to_wifi_retry_threshold;
    f32 min_success_rate_before_escalation;
    u64 min_ble_samples_before_success_rate_escalation;
    i16 rssi_switch_threshold;
    u64 congestion_queue_threshold;
    u64 stability_window_secs;
    u64 poor_signal_duration_secs;
    u8 ttl_escalation_threshold;
    u64 congestion_duration_secs;
    u64 ttl_escalation_hold_secs;
    u64 history_window_size;
    f32 queue_recovery_ratio;
};

// ACK configuration
dictionary AckConfig {
    u64 default_timeout_ms;
    u64 max_pending_acks;
};

// Retry configuration
dictionary RetryConfig {
    u32 max_retries;
    u64 initial_delay_ms;
    u64 max_delay_ms;
    f32 backoff_multiplier;
    u64 outbox_max_lifetime_ms;
    u64 pending_message_max_lifetime_ms;
};

// Deduplication configuration
dictionary DedupConfig {
    u64 max_tracked_messages;
    u64 retention_time_secs;
};

// Deduplicator statistics for monitoring
dictionary DedupStats {
    u64 total_tracked;
    u64 recent_tracked;
    u8 capacity_used_percent;
    string mode;
};

// Reliability configuration
dictionary ReliabilityConfig {
    AckConfig ack;
    RetryConfig retry;
    DedupConfig dedup;
};

// Path selection configuration
dictionary PathConfig {
    u32 forward_to_top_k;
    u32 max_congestion_level;
};

// Gradient routing table entry - represents a learned route to a destination
dictionary RouteEntry {
    string next_hop;
    u8 hop_count;
    f32 quality;
    u64 last_seen_ms;
};

// Gradient routing configuration
dictionary GradientRoutingConfig {
    u32 max_routes_per_destination;
    u64 route_ttl_secs;
    u32 max_routing_table_size;
};

// Routing table statistics for monitoring
dictionary RoutingStats {
    u32 destination_count;
    u32 route_count;
};

// Relay configuration
dictionary RelayConfig {
    u64 relay_threshold;
    u8 min_battery_for_relay;
    boolean allow_relay;
    RelayPriority relay_priority;
};

// Transport configuration
dictionary TransportConfig {
    boolean ble_enabled;
    boolean wifi_direct_enabled;
    boolean internet_enabled;
    boolean reticulum_enabled;
    boolean nostr_enabled;
    // See ProtocolConfig::nostr_sealing_enabled. Defaulted so existing callers
    // keep compiling.
    boolean nostr_sealing_enabled = true;
    // See ProtocolConfig::nostr_cold_contact_enabled.
    boolean nostr_cold_contact_enabled = true;
};

enum OverflowPolicy {
    "DropOldest",
    "DropNewest",
};

dictionary PendingQueueConfig {
    u64 max_pending_per_peer;
    u64 max_pending_global;
    u64 pending_ttl_ms;
    OverflowPolicy overflow_policy;
};

// Encryption configuration for automatic MLS handling
dictionary EncryptionConfig {
    boolean enabled;
    boolean auto_key_exchange;
    boolean store_pending;
    // Fail-closed default (SEC-M3): plaintext operation is an explicit opt-out.
    boolean require_encryption = true;
    PendingQueueConfig pending_queue;
};

// Extended configuration for protocol creation
dictionary ProtocolConfig {
    string app_id;
    string user_id;
    boolean ble_enabled;
    boolean wifi_direct_enabled;
    boolean internet_enabled;
    boolean reticulum_enabled;
    boolean nostr_enabled;
    boolean prefer_online;
    u8 initial_ttl;
    boolean encryption_enabled;
    boolean auto_key_exchange;
    boolean store_pending;
    // Fail-closed default (SEC-M3): plaintext operation is an explicit opt-out.
    boolean require_encryption = true;
    u64 max_pending_per_peer;
    u64 max_pending_global;
    u64 pending_ttl_ms;
    OverflowPolicy overflow_policy;
    u32 max_group_members = 256;
    boolean group_relay_enabled = true;
    // Whether a relay-synced group may send one O(1) relay broadcast instead
    // of per-member fan-out. Default ON, but the flag alone never selects the
    // broadcast: the path additionally requires the connected relay to have
    // advertised the group_delivery_v2 capability (injected by the bridge via
    // internet_relay_capabilities). Such a relay answers every broadcast with
    // a settled per-recipient delivery report, and the SDK re-sends a
    // per-member copy to every MLS roster member the report does not account
    // for — so the broadcast keeps a delivery contract. Against an older
    // relay the gate fails closed and sends take per-member fan-out, which
    // inherits the full DM ladder — retry, offline push carrying the
    // ciphertext, park/flush, deferred ACK — at the cost of O(N) frames.
    // Set false to force per-member fan-out even against a v2 relay.
    // See GroupConfig::relay_broadcast_enabled for the full rationale.
    boolean group_relay_broadcast_enabled = true;
    // Whether an incoming MLS membership commit is REFUSED when the local
    // admin overlay does not authorize its committer. Off by default, and
    // enabling it is a decision about partition risk: refusing a commit means
    // declining the MLS merge, so this device's epoch stays behind every
    // member that accepted it and MLS cannot heal that — the app has to
    // re-invite. The check fails open on absent knowledge (no metadata, no
    // admin role stored) but cannot detect DIVERGENT admin views, so only
    // enable it for a closed deployment that controls role distribution, and
    // never on part of a fleet. With it off, unauthorized changes are still
    // applied and reported via group_unauthorized_membership_change.
    // See GroupConfig::enforce_admin_commits for the full rationale.
    // Defaulted so existing callers keep compiling.
    boolean group_enforce_admin_commits = false;
    boolean require_transport_identity = false;
    // Kill switch for the compact binary wire codec (default on). Negotiated
    // per-peer, so a mixed fleet stays on JSON automatically; decoding of
    // binary frames is always on regardless. Exposed here so an app can disable
    // advertising/emitting at runtime without an SDK release if a field interop
    // issue ever surfaces. Defaulted so existing callers keep compiling.
    boolean binary_wire_enabled = true;
    // Kill switch for sealing outgoing Nostr frames into NIP-59 gift wraps
    // (default on). Unlike the three negotiated switches around it, this one
    // needs no peer capability on the receive side: the receive path always
    // unseals gift wraps and always parses legacy frames, so nothing a peer
    // sends us becomes unreadable whatever this is set to.
    // With it off, the transport publishes the legacy kind-4 event whose
    // content is the whole protocol envelope in cleartext -- both usernames,
    // the app id, the metadata map, the content type and a millisecond
    // timestamp, readable by every relay, permanently.
    // Two reasons to turn it off: a relay that rejects kind 1059, and reaching
    // a peer on a build that predates sealing -- such a peer subscribes with
    // kinds [4] only, so it is never handed our kind-1059 events and cannot
    // unseal one, making it unreachable over Nostr while this is on.
    // Defaulted so existing callers keep compiling.
    boolean nostr_sealing_enabled = true;
    // Kill switch for Nostr key-package publication and peer resolution
    // (default on; only takes effect when nostr_enabled is on, which is off by
    // default). Buys cold first contact -- reaching a peer known only by
    // username over Nostr, with no prior key-package exchange -- at the cost of
    // this install publishing a small set of addressable records at its routing
    // tag and refreshing them as slots are consumed. Their content is sealed,
    // but their existence and refresh timing are visible to every relay
    // published to. Turn it off to keep the transport silent until it has
    // traffic. Defaulted so existing callers keep compiling.
    boolean nostr_cold_contact_enabled = true;
    // Kill switch for the compact MLS envelope on encrypted messages (default
    // on). The end-to-end sibling of binary_wire_enabled with the same shape:
    // negotiated per-recipient via the key package, parsing of inbound compact
    // envelopes is always on, and disabling stops advertising and emitting so
    // both directions fall back to the JSON envelope. Defaulted so existing
    // callers keep compiling.
    boolean compact_envelope_enabled = true;
    // Kill switch for the sealed rich payload (default on): quoted-reply
    // context, rich media metadata, and forward attribution sealed inside
    // the MLS ciphertext. Negotiated per-recipient via the key package
    // (rich_versions); parsing of inbound sealed bodies is always on, and
    // disabling stops advertising and sealing so rich extras degrade to
    // being dropped — never sent cleartext. Defaulted so existing callers
    // keep compiling.
    boolean rich_payload_enabled = true;
    // Kill switch for 1:1 MLS crypto-failure recovery (default on): when a
    // 1:1 session falls out of epoch sync with the peer, an undecryptable DM
    // is not delivery-ACKed and a rate-limited session re-key heals the
    // channel, instead of silently dropping it. Failures that are not an
    // epoch mismatch (AEAD/authentication, discarded ratchet generations,
    // malformed frames) are unaffected and still fail closed. Note the re-key
    // trigger is unauthenticated by construction: the epoch is checked during
    // MLS framing validation, before the sender is verified, so anyone able to
    // inject a frame can drive a re-key. It is made safe by being bounded, not
    // by being trusted — confined to that peer's session slot, one per peer per
    // 30s, destroys no queued message, and reported as SESSION_REKEY_TRIGGERED.
    // Disabling reverts to the legacy drop-and-ACK behavior. Defaulted so
    // existing callers keep compiling.
    boolean crypto_recovery_enabled = true;
};

// Extended protocol configuration with all options
dictionary ProtocolConfigExtended {
    string app_id;
    string user_id;
    TransportConfig transport;
    DorsConfig dors;
    RelayConfig relay;
    PathConfig path;
    ReliabilityConfig reliability;
    u8 initial_ttl;
};

// ========================================================================
// TELEMETRY (unified observer surface — step 7 of the telemetry workstream)
// ========================================================================

// MLS lifecycle verbosity tier for TelemetryConfig.
enum MlsVerbosity {
    "Off",
    "Lifecycle",
    "Diagnostic",
};

// Underlying connection status of a single transport (distinct from the
// protocol-level selected transport reported via Event::TransportSwitched).
enum TransportStatus {
    "Available",
    "Unavailable",
    "Connecting",
    "Disconnected",
    "Error",
};

// Local relay role reported by DeviceCapabilitySnapshot.
enum RelayRole {
    "Regular",
    "Relay",
};

// Which kind of routing decision a RoutingDecision record describes.
// `Unknown` is emitted when the Rust core reports a variant this FFI build
// does not recognise (new-core/old-FFI skew) — consumers should surface
// "unrecognised" rather than collapse into an existing phase.
enum RoutingPhase {
    "ScoreUpdated",
    "Selected",
    "Switched",
    "Escalated",
    "Unknown",
};

// Flat reason space for routing decisions (unifies legacy DorsReasonCode /
// DorsEscalationReasonCode spaces). `Unknown` follows the same semantics as
// `RoutingPhase::Unknown`.
enum RoutingReasonCode {
    "InitialSelection",
    "PrimarySelected",
    "PrimarySuccess",
    "FallbackSuccess",
    "EscalationApplied",
    "CurrentUnavailable",
    "RetryThreshold",
    "PoorSignal",
    "Congestion",
    "LowTtl",
    "LowSuccessRate",
    "Unknown",
};

// Per-transport entry inside a MetricsFrame.
dictionary TransportMetricsEntry {
    TransportType transport;
    TransportMetrics metrics;
};

// Retry-queue statistics (mirrors offline_protocol_reliability::RetryQueueStats).
dictionary RetryQueueStats {
    u64 total_count;
    u64 ready_count;
    u64 critical_priority_count;
    u64 high_priority_count;
    u64 medium_priority_count;
    u64 low_priority_count;
};

// Deduplicator statistics (mirrors offline_protocol_reliability::DeduplicatorStats).
dictionary DeduplicatorStatsFrame {
    u64 total_tracked;
    u64 recent_tracked;
    u8 capacity_used_percent;
    f64? false_positive_rate;
    string mode;
};

// Periodic snapshot of protocol-wide counters and per-transport metrics.
dictionary MetricsFrame {
    i64 timestamp_ms;
    sequence<TransportMetricsEntry> transports;
    RetryQueueStats retry_queue;
    DeduplicatorStatsFrame dedup;
    u64 ack_pending;
    u64 neighbor_count;
    boolean is_local_relay;
    TransportType? current_transport;
};

// A single TransportStatus transition observed by the protocol engine.
dictionary TransportStateEvent {
    i64 timestamp_ms;
    TransportType transport;
    TransportStatus previous;
    TransportStatus current;
};

// Per-transport score breakdown carried by RoutingDecision at the diagnostic
// verbosity tier. Empty unless TelemetryConfig.routing_diagnostic is true.
dictionary RoutingScoreEntry {
    TransportType transport;
    f32 signal;
    f32 proximity;
    f32 bandwidth;
    f32 congestion;
    f32 energy;
    f32 reliability;
    f32 load;
    f32 total;
};

// A structured routing decision (superset of legacy Event::Dors* events).
dictionary RoutingDecision {
    i64 timestamp_ms;
    RoutingPhase phase;
    TransportType? from;
    TransportType? to;
    f32? winning_score;
    RoutingReasonCode? reason_code;
    sequence<RoutingScoreEntry> scores;
};

// Snapshot of local device capability at the moment of emission.
dictionary DeviceCapabilitySnapshot {
    i64 timestamp_ms;
    u8? battery_level;
    boolean is_charging;
    RelayRole relay_role;
    u8 changed_fields;
};

// Runtime configuration for the telemetry subsystem. All fields are optional
// on the foreign side; Rust applies the privacy-preserving defaults
// (scrub_ids=true, mls_verbosity=Lifecycle, metrics_cadence_ms=5000,
// routing_diagnostic=false, enable_poll_queue=true) when a field is null.
//
// `metrics_cadence_ms` encodes the cadence of periodic `MetricsFrame`
// emission in milliseconds. The single optional field cannot distinguish
// "use the default" (null) from "disable periodic emission" today — any
// explicit value overrides the default; null keeps it. If disable support
// is needed, extend this dict with a dedicated flag.
//
// `enable_poll_queue` (default true) controls whether the adapter builds
// the pull-channel JSON envelope on every emit. Push-only consumers should
// set this to false to skip per-emit `serde_json` serialization — the
// typed push callbacks still fire, but `poll_telemetry_frame` will always
// return null for records emitted under that config. Flip back to true
// (re-install the sink) to resume polling.
//
// `mls_sampling_bypass` (default false) opts a telemetry-grade sink out of the
// fixed-window limiter on high-volume MLS lifecycle events (mls.decryption_failed,
// mls.session_missing) so aggregate counts are not clipped to the per-window
// ceiling. Only enable it for sinks that apply their own backpressure.
dictionary TelemetryConfig {
    boolean? scrub_ids;
    MlsVerbosity? mls_verbosity;
    u64? metrics_cadence_ms;
    boolean? routing_diagnostic;
    boolean? enable_poll_queue;
    boolean? mls_sampling_bypass;
};

// Unified telemetry sink. Apps implement this to receive every typed
// TelemetryRecord the SDK emits: protocol events, MLS lifecycle, periodic
// metrics, transport state, routing decisions, device capability.
//
// Forward-compat: new TelemetryRecord variants added to the Rust enum that
// do not yet have a typed method here dispatch through on_extension with the
// record's stable snake.dot.case name and the inner payload as JSON.
//
// Failure semantics:
//   - on_metrics_frame / on_transport_state / on_routing_decision /
//     on_device_capability always fire — the DTOs are plain value types
//     crossing the FFI boundary. If the pull-queue JSON envelope fails
//     to serialize (e.g. NaN floats), only the pull channel gets a
//     `telemetry.error.<variant>` extension envelope; the push callback
//     is NOT re-fired through on_extension.
//   - on_protocol_event / on_mls_event only fire when the inner event
//     serializes. On failure, the typed callback is skipped and
//     on_extension fires with `telemetry.error.<variant>` so consumers
//     see exactly one record per emit.
//
// Implementations MUST NOT block, reenter the SDK, or panic — the emit path
// may be called while the protocol holds internal locks.
callback interface TelemetrySink {
    void on_protocol_event(string event_json);
    void on_mls_event(string event_json);
    void on_metrics_frame(MetricsFrame frame);
    void on_transport_state(TransportStateEvent event);
    void on_routing_decision(RoutingDecision decision);
    void on_device_capability(DeviceCapabilitySnapshot snapshot);
    void on_extension(string name, string payload_json);
};

// Event callback interface
callback interface EventCallback {
    void on_event(string event_json);
};

// BLE transport callback - notifies platform when outgoing fragments are available.
// Replaces timer-based polling with event-driven sending.
callback interface BleTransportCallback {
    void on_fragments_available();
};

// WiFi Direct transport callback - notifies platform when outgoing messages are available.
callback interface WifiDirectTransportCallback {
    void on_messages_available();
};

// Reticulum transport callback - notifies platform when outgoing messages are available.
callback interface ReticulumTransportCallback {
    void on_messages_available();
};

// Nostr transport callback - notifies platform when outgoing messages are available.
callback interface NostrTransportCallback {
    void on_messages_available();
};

// Main protocol interface
interface OfflineProtocol {
    // Create a new protocol instance
    [Throws=ProtocolError]
    constructor(ProtocolConfig config);
    
    // Lifecycle management
    [Throws=ProtocolError]
    void start();
    
    [Throws=ProtocolError]
    void stop();
    
    [Throws=ProtocolError]
    void pause();
    
    [Throws=ProtocolError]
    void resume();
    
    ProtocolState get_state();
    
    // Process the protocol (internal message processing)
    [Throws=ProtocolError]
    void process();
    
    // Event handling
    void set_event_callback(EventCallback callback);

    string? poll_event();

    void emit_test_event();

    // Install a unified telemetry sink. Replaces any previously installed
    // sink. Config fields left null fall back to the Rust-side defaults
    // (scrub_ids=true, mls_verbosity=Lifecycle, metrics_cadence_ms=5000,
    // routing_diagnostic=false).
    [Throws=ProtocolError]
    void install_telemetry_sink(TelemetrySink sink, TelemetryConfig config);

    // Poll the next buffered telemetry record as a JSON envelope. Every
    // envelope carries a `category` discriminator plus variant-specific
    // fields:
    //   protocol         → { "category": "protocol",         "eventJson": <string> }
    //   mls              → { "category": "mls",              "eventJson": <string> }
    //   metricsFrame     → { "category": "metricsFrame",     "frame":     <MetricsFrame> }
    //   transportState   → { "category": "transportState",   "event":     <TransportStateEvent> }
    //   routingDecision  → { "category": "routingDecision",  "decision":  <RoutingDecision> }
    //   deviceCapability → { "category": "deviceCapability", "snapshot":  <DeviceCapabilitySnapshot> }
    //   extension        → { "category": "extension",        "name": <string>, "payloadJson": <string> }
    //
    // Returns null when the queue is empty. The queue is bounded (1024
    // slots, drop-oldest on overflow). Records are only enqueued while a
    // sink is installed with `enable_poll_queue` left at its default (or
    // explicitly `true`). Polling before `install_telemetry_sink`, or
    // while a push-only sink (`enable_poll_queue = false`) is live,
    // returns null for new records — previously queued records remain
    // readable.
    //
    // Queue retention across sink replacement: calling
    // `install_telemetry_sink` a second time replaces the core-side sink
    // but does NOT drain the queue. A consumer installed as Sink B and
    // polling after a flurry of Sink A emits will see Sink A's records
    // first (FIFO). This is intentional — the queue is a property of the
    // FFI adapter, not of any individual sink. Apps that need a clean
    // slate should drain `poll_telemetry_frame` in a loop until it
    // returns null before installing the new sink, or call
    // `uninstall_telemetry_sink()` which both detaches the sink and
    // drains the queue in a single call.
    string? poll_telemetry_frame();

    // Detach the installed telemetry sink. Replaces the core-side sink
    // with a no-op (so future emissions are discarded with zero overhead)
    // and drains the pull queue so a subsequent
    // `install_telemetry_sink(...)` starts with an empty queue. Idempotent
    // — safe to call without a prior install.
    [Throws=ProtocolError]
    void uninstall_telemetry_sink();

    // Stable, opaque per-install telemetry identifier (32 hex chars),
    // derived from the SDK-managed persistent scrub secret. The secret
    // itself never crosses the FFI and cannot be recovered from the id.
    //
    // Returns null until the persistent secret is available — i.e. before
    // secure storage is wired via `initialize_mls`, or when persisting the
    // secret failed this session (the id would not be stable across launches,
    // so none is exposed). Unaffected by installing a telemetry sink or by an
    // app-supplied scrub secret.
    string? telemetry_install_id();

    // Messaging
    [Throws=ProtocolError]
    string send_message(string recipient, string content, MessagePriority priority, string? reply_to_msg);

    // Rich send surface: like send_message, but accepting SendMessageOptions
    // (reply context, rich media metadata, forward attribution — sealed
    // inside the MLS ciphertext for capable recipients, dropped otherwise).
    [Throws=ProtocolError]
    string send_message_rich(string recipient, string content, SendMessageOptions options);

    // Forward a message to a new recipient (preserves original sender attribution)
    [Throws=ProtocolError]
    string forward_message(string original_message_json, string new_recipient, MessagePriority? priority);

    string? receive_message();

    // Connection requests (transport-agnostic, routed via DORS)
    [Throws=ProtocolError]
    string send_connection_request(string recipient, string sender_name, sequence<u8>? key_package, string? initial_message);

    [Throws=ProtocolError]
    string accept_connection_request(string recipient, string accepter_name, sequence<u8>? key_package);

    [Throws=ProtocolError]
    string reject_connection_request(string recipient);

    [Throws=ProtocolError]
    string cancel_connection_request(string recipient);

    // BLE transport callback (event-driven sending, replaces timer-based polling)
    void set_ble_transport_callback(BleTransportCallback callback);
    
    // WiFi Direct transport callback (event-driven sending, replaces timer-based polling)
    void set_wifi_direct_transport_callback(WifiDirectTransportCallback callback);
    
    // BLE transport operations
    [Throws=ProtocolError]
    void ble_peer_discovered(string peer_id, i16 rssi);
    
    [Throws=ProtocolError]
    void ble_peer_lost(string peer_id);
    
    [Throws=ProtocolError]
    void ble_status_changed(boolean is_available);
    
    [Throws=ProtocolError]
    void ble_fragment_received(string sender_id, sequence<u8> fragment);

    BleFragment? ble_get_next_fragment();

    void ble_return_fragment();

    u32 ble_get_peer_count();

    // Per-peer MTU reporting. Platforms call ble_set_peer_mtu after BLE MTU
    // negotiation completes for a link, passing the already-header-adjusted
    // max fragment payload (iOS: peripheral.maximumWriteValueLength; Android:
    // onMtuChanged's mtu - 3). ble_clear_peer_mtu is called on disconnect.
    [Throws=ProtocolError]
    void ble_set_peer_mtu(string peer_id, u32 max_payload);

    [Throws=ProtocolError]
    void ble_clear_peer_mtu(string peer_id);

    // Monotonic lifetime counter of undersized MTU reports (< BLE_MAX_FRAGMENT_SIZE).
    // Non-zero means at least one peer's real link capacity is below the Rust
    // fallback floor — outbound writes to that peer are being dropped by the
    // controller. Surface in dashboards.
    u64 ble_undersized_mtu_reports();

    // Monotonic lifetime counter of fragment_message calls that fell back
    // to the Rust fragment-size floor because no per-peer MTU was on file
    // AND the recipient is still a registered direct BLE peer. In healthy
    // operation this should remain zero — both platforms push MTU before
    // announcing the peer, so by the time a send can reach a live peer
    // the MTU is already on file. Non-zero means either the MTU-before-
    // discover ordering invariant regressed, or the recipient → device_id
    // keying contract broke — every fragmenting send to live peers is
    // then silently regressing to the 185-byte floor.
    u64 ble_fragment_fallback_count();

    // Internet transport operations
    [Throws=ProtocolError]
    void internet_status_changed(boolean is_connected);
    
    [Throws=ProtocolError]
    void internet_message_received(string sender_id, sequence<u8> data);
    
    InternetMessage? internet_get_next_message();
    
    void internet_confirm_sent(string message_id);
    
    void internet_send_failed(string message_id);
    
    void internet_send_failed_with_reason(string message_id, string? reason);

    // Internet: relay-sourced presence for a peer (PresenceStatus /
    // PresenceStatusWithLastSeen answers). online=true re-arms parked
    // welcomes and flushes queued traffic; online=false parks pending
    // welcomes without burning retry budget. Emits presence_updated, except
    // for self, blocked, or empty peer ids (dropped without an event).
    void internet_peer_presence(string peer_id, boolean online, i64? last_seen_ms);

    // Internet: peers the platform layer should watch via relay presence
    // queries (CheckPresence) — every peer with an undelivered or
    // session-unproven MLS welcome.
    sequence<string> internet_presence_watchlist();

    // Internet: capability tokens from the relay's Authenticated answer
    // (e.g. "group_delivery_v2"). MUST be called BEFORE
    // internet_status_changed(true) on each (re)connect — the false→true
    // flush has to see the capabilities, or the first sends after reconnect
    // take the capability-less path. Wholesale replace; the SDK clears the
    // set itself when the Internet transport drops. Relays that predate the
    // advertisement: pass an empty list (or skip the call — the set is
    // already empty after a drop).
    [Throws=ProtocolError]
    void internet_relay_capabilities(sequence<string> capabilities);

    // Internet: a relay GroupMessageSent settled delivery report, forwarded
    // as the raw server frame JSON. Correlated by its message_id to an
    // in-flight group broadcast; members the relay did not reach get a
    // per-member re-send and the app sees group_message_delivery_report.
    // A dedicated entry point (not message-plane injection) so it cannot be
    // forged through the notification ciphertext injector. Reports that
    // correlate with nothing are ignored; malformed JSON throws.
    [Throws=ProtocolError]
    void internet_group_report_received(string report_json);

    // WiFi Direct transport operations
    [Throws=ProtocolError]
    void wifi_direct_status_changed(boolean is_connected);
    
    [Throws=ProtocolError]
    void wifi_direct_message_received(string sender_id, sequence<u8> data);
    
    WifiDirectMessage? wifi_direct_get_next_message();
    
    [Throws=ProtocolError]
    void wifi_direct_peer_connected(string peer_id);
    
    [Throws=ProtocolError]
    void wifi_direct_peer_disconnected(string peer_id);

    // Reticulum transport callback (event-driven sending)
    void set_reticulum_transport_callback(ReticulumTransportCallback callback);

    // Reticulum transport operations
    [Throws=ProtocolError]
    void reticulum_status_changed(boolean is_connected);

    [Throws=ProtocolError]
    void reticulum_message_received(string sender_id, sequence<u8> data);

    ReticulumMessage? reticulum_get_next_message();

    void reticulum_confirm_sent(string message_id);

    void reticulum_send_failed(string message_id);

    void reticulum_send_failed_with_reason(string message_id, string? reason);

    // Nostr transport callback (event-driven sending)
    void set_nostr_transport_callback(NostrTransportCallback callback);

    // Nostr transport operations
    [Throws=ProtocolError]
    void nostr_status_changed(boolean is_connected);

    [Throws=ProtocolError]
    void nostr_message_received(string sender_id, sequence<u8> data);

    // Preferred over nostr_message_received: `created_at` is the relay event's
    // unix-seconds timestamp, which advances the persisted receive watermark
    // that bounds how far back the next subscription's `since` reaches.
    [Throws=ProtocolError]
    void nostr_message_received_at(string sender_id, sequence<u8> data, i64 created_at);

    NostrMessage? nostr_get_next_message();

    void nostr_confirm_sent(string message_id);

    void nostr_send_failed(string message_id);

    void nostr_send_failed_with_reason(string message_id, string? reason);

    string? nostr_get_public_key();

    string? nostr_get_subscription_filter(string subscription_id);

    // Returns the next pending key-package resolution query, or null. The
    // platform sends `req_json` to its relays, keeps the subscription open
    // under `query_id`, and routes matching events back via
    // nostr_query_event_received.
    NostrQuery? nostr_get_next_query();

    // Delivers one event received on a resolution query's subscription.
    // `event_json` is the event object (the third element of the relay's
    // ["EVENT", sub_id, {...}] message), passed through verbatim.
    [Throws=ProtocolError]
    void nostr_query_event_received(string query_id, string event_json);

    // Releases a resolution query once the relay signals end-of-stored-events.
    // The platform should also send ["CLOSE", query_id].
    void nostr_query_completed(string query_id);

    // Transport management
    [Throws=ProtocolError]
    void remove_transport(TransportType transport_type);
    
    sequence<string> get_active_transports();
    
    // Legacy no-op retained only for source/ABI compat. Every field of
    // `metrics` (including the 12 extended optional fields) is discarded.
    // Read live data via `get_transport_metrics(...)` or install a
    // `TelemetrySink` to observe push `MetricsFrame`s instead. Scheduled
    // for removal in the v1.0 release.
    [Throws=ProtocolError]
    void update_transport_metrics(TransportType transport_type, TransportMetrics metrics);
    
    // DORS decision support
    boolean should_escalate_to_wifi();
    
    // Media and file transfer
    [Throws=ProtocolError]
    string send_media(string recipient, sequence<u8> file_data, string file_name, ContentType content_type, MediaMetadata? media_metadata);

    // Rich media send surface: like send_media, but accepting MediaSendOptions
    // (caption, reply threading, quoted-reply context, forward attribution,
    // caller-supplied file_id). Rich fields travel sealed inside the chunk-0
    // MLS ciphertext toward rich-capable recipients and are silently dropped
    // otherwise — never sent cleartext.
    [Throws=ProtocolError]
    string send_media_rich(string recipient, sequence<u8> file_data, string file_name, ContentType content_type, MediaSendOptions options);

    [Throws=ProtocolError]
    string send_file(string recipient, sequence<u8> file_data, string file_name);
    
    [Throws=ProtocolError]
    void process_file_chunk(string file_id, u32 chunk_index, u32 total_chunks, u64 file_size, string file_name, string file_checksum, sequence<u8> data);
    
    FileProgress? get_file_progress(string file_id);
    
    [Throws=ProtocolError]
    void finalize_file(string file_id);
    
    [Throws=ProtocolError]
    void cancel_file_transfer(string file_id);
    
    // Network visualization and metrics
    [Throws=ProtocolError]
    NetworkTopology get_topology();
    
    sequence<MessageStats> get_message_stats();
    
    f32 get_delivery_success_rate();
    
    u64 get_median_latency();
    
    u8 get_median_hops();
    
    // Battery and device management
    void set_battery_level(u8 level);
    
    u8? get_battery_level();
    
    // Relay management
    [Throws=ProtocolError]
    void set_relay_priority(RelayPriority priority);
    
    RelayPriority get_relay_priority();
    
    boolean is_relay();
    
    // Transport metrics (per-transport detailed stats)
    TransportMetrics? get_transport_metrics(TransportType transport_type);
    
    // Manual transport control
    [Throws=ProtocolError]
    void force_transport(TransportType transport_type);
    
    void release_transport_lock();
    
    // Configuration updates (runtime)
    [Throws=ProtocolError]
    void update_dors_config(DorsConfig config);
    
    DorsConfig get_dors_config();
    
    // Gradient routing table operations
    // Learn a route from an incoming message - call when receiving a message from a neighbor.
    // sequence_number: DSDV-style; pass 0 when the message does not carry a destination sequence.
    void learn_route(string destination, string next_hop, u8 hop_count, f32 quality, u32 sequence_number);
    
    // Get the best (highest quality) route to a destination
    RouteEntry? get_best_route(string destination);
    
    // Get all valid (non-expired) routes to a destination
    sequence<RouteEntry> get_all_routes(string destination);
    
    // Check if a route exists to the destination
    boolean has_route(string destination);
    
    // Remove all routes through a neighbor (call on disconnect)
    void remove_neighbor_routes(string neighbor_id);
    
    // Clean up expired routes (call periodically)
    void cleanup_expired_routes();
    
    // Get routing table statistics
    RoutingStats get_routing_stats();
    
    // Update gradient routing configuration
    void update_routing_config(GradientRoutingConfig config);
    
    // Reliability configuration updates
    [Throws=ProtocolError]
    void update_ack_config(AckConfig config);
    [Throws=ProtocolError]
    void update_retry_config(RetryConfig config);
    [Throws=ProtocolError]
    void update_dedup_config(DedupConfig config);
    
    // Reliability statistics for monitoring
    DedupStats get_dedup_stats();
    u64 get_pending_ack_count();
    u64 get_retry_queue_size();
    
    // ========================================================================
    // MLS (END-TO-END ENCRYPTION) OPERATIONS
    // ========================================================================
    
    // Initialize MLS with separate secure and install-scoped state providers.
    [Throws=ProtocolError]
    void initialize_mls(
        MlsStorageProvider secure_storage,
        ProtocolStateStorageProvider protocol_state_storage
    );
    
    // Check if MLS is initialized
    boolean is_mls_initialized();
    
    // Generate a key package for distribution to others
    [Throws=ProtocolError]
    MlsKeyPackageBundle mls_generate_key_package();
    
    // Get an existing key package or generate a new one
    [Throws=ProtocolError]
    MlsKeyPackageBundle mls_get_or_create_key_package();
    
    // Import a contact's key package (for initiating encrypted sessions)
    [Throws=ProtocolError]
    void mls_import_key_package(string user_id, sequence<u8> key_package_data);
    
    // Get pending key packages that need to be uploaded to server
    sequence<MlsKeyPackageBundle> mls_get_pending_key_packages();
    
    // Mark a key package as synced to server
    [Throws=ProtocolError]
    void mls_mark_key_package_synced(string package_id);
    
    // Check if a 1:1 session exists with another user
    boolean mls_has_session(string other_user_id);
    
    // Check if a pending key package is available for a peer
    boolean has_pending_key_package(string peer_id);
    
    // Return the current establishment state for a peer (for UI/retry when SessionNotReady)
    [Throws=ProtocolError]
    EstablishmentState get_establishment_state(string peer_id);
    
    // Establish a secure session with a peer (high-level API)
    // Returns the Welcome message if session was created, null if session already exists
    // Throws if no key package is available for the peer
    [Throws=ProtocolError]
    MlsWelcomeMessage? establish_secure_session(string peer_id);
    
    // Create a 1:1 session with another user (returns Welcome to send)
    [Throws=ProtocolError]
    MlsWelcomeMessage mls_create_session(string other_user_id);
    
    // Join a session using a Welcome message
    [Throws=ProtocolError]
    MlsGroupInfo mls_join_session(MlsWelcomeMessage welcome);
    
    // Encrypt a message for a 1:1 session
    [Throws=ProtocolError]
    MlsEncryptedMessage mls_encrypt_for_user(string other_user_id, sequence<u8> plaintext);
    
    // Decrypt a message from a 1:1 session
    [Throws=ProtocolError]
    sequence<u8>? mls_decrypt_from_user(MlsEncryptedMessage encrypted);
    
    // List all active 1:1 sessions
    sequence<string> mls_list_sessions();
    
    // Delete a 1:1 session
    [Throws=ProtocolError]
    void mls_delete_session(string other_user_id);
    
    // Get a pending Welcome message that needs to be sent
    MlsWelcomeMessage? mls_get_pending_welcome(string other_user_id);
    
    // Clear a pending Welcome message after sending
    [Throws=ProtocolError]
    void mls_clear_pending_welcome(string other_user_id);
    
    // Decrypt any encrypted message (auto-detects session vs group)
    [Throws=ProtocolError]
    sequence<u8>? mls_decrypt(MlsEncryptedMessage encrypted);
    
    // Process a Welcome message (auto-detects session vs group)
    [Throws=ProtocolError]
    MlsGroupInfo mls_process_welcome(MlsWelcomeMessage welcome);
    
    // ========================================================================
    // IDENTITY AND SIGNING OPERATIONS
    // ========================================================================
    
    // Get the identity public key (Ed25519, 32 bytes).
    // This is the public key used for MLS operations and can be shared with others.
    [Throws=ProtocolError]
    sequence<u8> get_identity_public_key();
    
    // Derive a deterministic user ID from a public key.
    // Returns a base58-encoded string derived from SHA-256(publicKey)[0:20].
    // The same public key always produces the same user ID.
    string derive_user_id_from_public_key(sequence<u8> public_key);
    
    // Sign arbitrary data with the identity private key (Ed25519).
    // Returns the signature as raw bytes (64 bytes).
    [Throws=ProtocolError]
    sequence<u8> sign_data(sequence<u8> data);
    
    // Verify a signature against a public key.
    // Returns true if the signature is valid, false otherwise.
    [Throws=ProtocolError]
    boolean verify_signature(sequence<u8> public_key, sequence<u8> data, sequence<u8> signature);
    
    // ========================================================================
    // PRESENCE, TYPING INDICATORS, AND READ RECEIPTS
    // ========================================================================

    // Send a presence update to a peer via the protocol (routed through DORS).
    // Returns the message ID.
    [Throws=ProtocolError]
    string send_presence_update(string recipient, PresenceStatus status);

    // Send a typing indicator to a peer via the protocol (routed through DORS).
    // For direct messages, conversation_id should be the recipient's username.
    // For group chats, conversation_id should be the group_id.
    // Returns the message ID.
    [Throws=ProtocolError]
    string send_typing_indicator(string recipient, string conversation_id, boolean is_typing);

    // Send a read receipt to a peer via the protocol (routed through DORS).
    // Indicates that the given messages have been read.
    // Returns the message ID.
    [Throws=ProtocolError]
    string send_read_receipt(string recipient, sequence<string> message_ids);

    // ========================================================================
    // RELAY SERVER API (JSON payload formatters for WebSocket relay)
    // ========================================================================

    // Check if a user is online via relay server.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string check_presence(string username);

    // Request prekey bundle for a user to establish encrypted communication.
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string request_prekey_bundle(string username);

    // Upload identity key and prekeys for Signal Protocol.
    // Returns JSON string to send via WebSocket relay.
    // Parameters are JSON strings that will be parsed and included in the payload.
    [Throws=ProtocolError]
    string upload_keys(string identity_key, string signed_prekey_json, string one_time_prekeys_json);

    // Set typing indicator via relay server (JSON payload formatter).
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string set_typing(string conversation_id);

    // Clear typing indicator via relay server (JSON payload formatter).
    // Returns JSON string to send via WebSocket relay.
    [Throws=ProtocolError]
    string clear_typing(string conversation_id);
    
    // ========================================================================
    // GROUP MESSAGING (MLS-encrypted, transport-agnostic)
    // ========================================================================

    // Create a new MLS group
    [Throws=ProtocolError]
    MlsGroupInfo create_group(string group_name);

    // Send an MLS-encrypted message to all group members
    [Throws=ProtocolError]
    sequence<string> send_group_message(string group_id, string content, MessagePriority? priority, string? reply_to_msg);

    // Forward a message to all members of a group (preserves original sender attribution)
    [Throws=ProtocolError]
    sequence<string> forward_message_to_group(string original_message_json, string group_id, MessagePriority? priority);

    // Invite a user to an MLS group
    [Throws=ProtocolError]
    void invite_to_group(string group_id, string invitee_user_id);

    // Remove a member from an MLS group
    [Throws=ProtocolError]
    void remove_from_group(string group_id, string member_id);

    // Leave an MLS group
    [Throws=ProtocolError]
    void leave_group(string group_id);

    // List all MLS groups (excluding 1:1 sessions)
    [Throws=ProtocolError]
    sequence<string> list_groups();

    // Get information about an MLS group
    [Throws=ProtocolError]
    MlsGroupInfo? get_group_info(string group_id);

    // Whether a rich group send right now would seal its extras, and which
    // members hold the gate closed (point-in-time, advisory)
    [Throws=ProtocolError]
    GroupRichReadiness group_rich_readiness(string group_id);

    // Relay-side registration state of a group (point-in-time; transitions
    // surface as the group_relay_sync_changed event)
    [Throws=ProtocolError]
    RelaySyncState group_relay_sync_state(string group_id);

    // Register (or re-register) a group with the relay server on demand —
    // the supported path before relay-dependent raw server commands
    // (invite links). Outcome arrives as group_relay_sync_changed; returns
    // true when the frame was queued or the group is already synced, false
    // when relay grouping is disabled or Internet is unavailable
    [Throws=ProtocolError]
    boolean request_group_relay_registration(string group_id);

    // Set a member's role in a group (admin only, broadcasts to all members)
    [Throws=ProtocolError]
    void set_member_role(string group_id, string user_id, string role);

    // Get a member's role in a group
    [Throws=ProtocolError]
    string get_member_role(string group_id, string user_id);

    // Get all member roles in a group (returns user_id -> role map)
    [Throws=ProtocolError]
    record<DOMString, string> get_group_roles(string group_id);

    // Rename a group (admin only, broadcasts to all members)
    [Throws=ProtocolError]
    void rename_group(string group_id, string new_name);

    // Reset the TOFU-pinned public key for a peer (allows re-pinning on next contact).
    // Returns true if an entry was removed, false if no entry existed (idempotent).
    [Throws=ProtocolError]
    boolean reset_tofu_for_peer(string peer_id);

    // Block a user (silently drops all their messages, no notification sent)
    [Throws=ProtocolError]
    void block_user(string user_id);

    // Unblock a previously blocked user
    [Throws=ProtocolError]
    void unblock_user(string user_id);

    // Get list of currently blocked user IDs
    [Throws=ProtocolError]
    sequence<string> get_blocked_users();

    // Check if a user is currently blocked
    [Throws=ProtocolError]
    boolean is_user_blocked(string user_id);

};

// Standalone mesh services interface
interface MeshServices {
    [Throws=ProtocolError]
    constructor(OfflineProtocol protocol);

    [Throws=ProtocolError]
    void register_service(string service_id, string version, record<DOMString, string> capabilities);

    [Throws=ProtocolError]
    boolean unregister_service(string service_id);

    [Throws=ProtocolError]
    string discover_services(string? service_id);

    [Throws=ProtocolError]
    string send_service_request(string provider, string service_id, string method, string body);

    [Throws=ProtocolError]
    string respond_to_service_request(string request_id, string requester, string service_id, string status, string body);
};

// BLE fragment for outgoing data
dictionary BleFragment {
    string recipient_id;
    sequence<u8> data;
};

// Internet message for outgoing data. control_op tags server-plane control
// frames the platform bridge must translate to (or mirror as) relay-native
// messages instead of an opaque SendMessage: conn_req / conn_acc / conn_rej /
// conn_can (replace), group_relay_register / group_relay_broadcast (replace),
// group_mls_leave (send verbatim AND send one relay-native LeaveGroup).
// control_payload is the JSON after the internal prefix (empty for
// payload-less ops). Null control_op = normal traffic, send verbatim.
dictionary InternetMessage {
    string message_id;
    string recipient_id;
    sequence<u8> data;
    string? reply_to_msg;
    string? control_op;
    string? control_payload;
};

// WiFi Direct message for outgoing data
dictionary WifiDirectMessage {
    string recipient_id;
    sequence<u8> data;
};

// Reticulum message for outgoing data
dictionary ReticulumMessage {
    string message_id;
    string recipient_id;
    sequence<u8> data;
    string? reply_to_msg;
};

// Nostr message for outgoing data
dictionary NostrMessage {
    string message_id;
    string event_id;
    string event_json;
};

// A relay query the platform should issue on the transport's behalf, to fetch
// a peer's published key-package records. `query_id` is also the NIP-01
// subscription id: the platform must use it verbatim so inbound events route
// back to the right request.
dictionary NostrQuery {
    string query_id;
    string req_json;
};
