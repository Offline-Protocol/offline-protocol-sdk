  "json_disambiguation": {
    "note": "A legacy JSON envelope begins `{\"`. Read as a little-endian u32 group_id length, those two bytes are the low half of the value, so the declared length is 8827 plus whatever the next two bytes contribute: 8827 is its minimum, not its value, and every JSON body is at or above it. The cap is 4096, so the compact parser rejects the whole class deterministically and the caller falls through to JSON. This is why the two forms need no version byte between them.",
    "prefix_utf8": "{\"",
    "min_as_le_u32": 8827,
    "exceeds_max_string_field_len": true
  }
