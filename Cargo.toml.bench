# Add this section to the root Cargo.toml to enable benchmarks

[[bench]]
name = "message_throughput"
harness = false

[[bench]]
name = "protocol_performance"
harness = false

[[bench]]
name = "dors_selection"
harness = false

[[bench]]
name = "ble_fragmentation"
harness = false

[dev-dependencies]
criterion = { workspace = true }
offline-protocol-core = { path = "crates/offline-protocol-core" }
offline-protocol-transport = { path = "crates/offline-protocol-transport" }
offline-protocol-router = { path = "crates/offline-protocol-router" }
offline-protocol = { path = "crates/offline-protocol" }

